generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  password     String
  role         String      @default("citizen") // 'citizen', 'officer', 'department_head', 'admin'
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  phone        String?     @default("")
  avatar       String?     @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=200")
  ward         String?     @default("Ward 80 - Indiranagar")
  city         String?     @default("Bengaluru")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  citizenComplaints Complaint[]          @relation("CitizenComplaints")
  officerComplaints Complaint[]          @relation("OfficerComplaints")
  statusHistory     StatusHistory[]
  comments          Comment[]
  notifications     Notification[]
  supportedTickets  ComplaintSupporter[]

  @@map("users")
}

model Department {
  id                 String   @id @default(uuid())
  name               String   @unique
  code               String   @unique
  description        String?  @db.Text
  issueTypesHandled String?  @db.Text
  zoneCoverage       String?  @db.Text
  categories         String?  @db.Text
  contactEmail       String
  contactPhone       String?  @default("+91-800-CIVIC-001")
  SLAHours           Int      @default(48)
  activeTicketCount  Int      @default(0)
  icon               String?  @default("Building2")
  headOfficerId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users      User[]
  complaints Complaint[]

  @@map("departments")
}

model Complaint {
  id                      String     @id @default(uuid())
  ticketId                String     @unique
  citizenId               String
  citizen                 User       @relation("CitizenComplaints", fields: [citizenId], references: [id])
  title                   String
  description             String     @db.Text
  category                String     @default("General Civic Issue")
  issueType               String?    @default("General Civic Issue")
  severity                String     @default("Medium")
  priorityScore           Int        @default(50)
  priorityLevel           String     @default("Medium")
  status                  String     @default("Reported")
  latitude                Float      @default(12.9716)
  longitude               Float      @default(77.5946)
  address                 String?    @db.Text
  ward                    String?    @default("Ward 80 - Indiranagar")
  zone                    String?    @default("East Zone")
  city                    String?    @default("Bengaluru")
  district                String?    @default("Bengaluru Urban")
  state                   String?    @default("Karnataka")
  assignedDepartmentId    String?
  assignedDepartment      Department? @relation(fields: [assignedDepartmentId], references: [id])
  assignedOfficerId       String?
  assignedOfficer         User?      @relation("OfficerComplaints", fields: [assignedOfficerId], references: [id])
  affectedCount           Int        @default(1)
  isDuplicate             Boolean    @default(false)
  duplicateOfComplaintId String?
  duplicateOf             Complaint? @relation("DuplicateRelations", fields: [duplicateOfComplaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates              Complaint[] @relation("DuplicateRelations")
  duplicateDistanceMeters Float?     @default(0)
  slaDueDate              DateTime?
  isEscalated             Boolean    @default(false)
  escalationReason        String?    @db.Text
  tags                    String?    @db.Text
  ratings                 String?    @db.Text
  agentResults            String?    @db.Text
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  media               ComplaintMedia[]
  comments            Comment[]
  statusHistory       StatusHistory[]
  agentLogs           AgentLog[]
  notifications       Notification[]
  primaryDuplicates   ComplaintDuplicate[] @relation("PrimaryDuplicate")
  secondaryDuplicates ComplaintDuplicate[] @relation("SecondaryDuplicate")
  supporters          ComplaintSupporter[]

  @@index([latitude, longitude])
  @@index([status])
  @@index([priorityLevel])
  @@index([assignedDepartmentId])
  @@map("complaints")
}

model ComplaintMedia {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  url         String    @db.Text
  type        String    // 'image', 'voice', 'video', 'document'
  name        String?
  createdAt   DateTime  @default(now())

  @@map("complaint_media")
}

model StatusHistory {
  id             String    @id @default(uuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousStatus String
  status         String
  note           String?   @db.Text
  updatedById    String
  updatedBy      User      @relation(fields: [updatedById], references: [id])
  createdAt      DateTime  @default(now())

  @@map("complaint_status_history")
}

model Comment {
  id             String    @id @default(uuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  text           String    @db.Text
  isOfficialNote Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@map("complaint_comments")
}

model Notification {
  id          String     @id @default(uuid())
  recipientId String
  recipient   User       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  title       String
  message     String     @db.Text
  type        String     @default("info")
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@map("notifications")
}

model AgentLog {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  agentName    String
  stepNumber   Int
  input        String?   @db.Text
  output       String?   @db.Text
  confidence   Float     @default(0.95)
  executionTime Int      @default(100)
  status       String    @default("success")
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())

  @@map("agent_logs")
}

model ComplaintDuplicate {
  id                   String    @id @default(uuid())
  primaryComplaintId   String
  primaryComplaint     Complaint @relation("PrimaryDuplicate", fields: [primaryComplaintId], references: [id], onDelete: Cascade)
  duplicateComplaintId String
  duplicateComplaint   Complaint @relation("SecondaryDuplicate", fields: [duplicateComplaintId], references: [id], onDelete: Cascade)
  distanceMeters       Float
  createdAt            DateTime  @default(now())

  @@map("complaint_duplicates")
}

model ComplaintSupporter {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizenId   String
  citizen     User      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("complaint_supporters")
}

model AnalyticsCache {
  id        String   @id @default(uuid())
  key       String   @unique
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("analytics_cache")
}
